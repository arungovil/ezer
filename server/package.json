{
  "name": "ezer-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ezer Server: LLM-backed capture extraction and chat for the personal assistant",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
